{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "bun:test": ["./node_modules/bun-types/test.d.ts"],
      "@terminus/domain": ["./packages/domain/src/index.ts"],
      "@terminus/runtime-protocol": ["./packages/runtime-protocol/src/index.ts"],
      "@terminus/context-ir": ["./packages/context-ir/src/index.ts"],
      "@terminus/context-compiler": ["./packages/context-compiler/src/index.ts"],
      "@terminus/provider-core": ["./packages/provider-core/src/index.ts"],
      "@terminus/provider-openai": ["./packages/provider-openai/src/index.ts"],
      "@terminus/provider-anthropic": ["./packages/provider-anthropic/src/index.ts"],
      "@terminus/provider-google": ["./packages/provider-google/src/index.ts"],
      "@terminus/provider-local": ["./packages/provider-local/src/index.ts"],
      "@terminus/model-router": ["./packages/model-router/src/index.ts"],
      "@terminus/task-runtime": ["./packages/task-runtime/src/index.ts"],
      "@terminus/session-runtime": ["./packages/session-runtime/src/index.ts"],
      "@terminus/orchestration": ["./packages/orchestration/src/index.ts"],
      "@terminus/verification": ["./packages/verification/src/index.ts"],
      "@terminus/memory": ["./packages/memory/src/index.ts"],
      "@terminus/capability-registry": ["./packages/capability-registry/src/index.ts"],
      "@terminus/extension-host": ["./packages/extension-host/src/index.ts"],
      "@terminus/adapter-sdk": ["./packages/adapter-sdk/src/index.ts"],
      "@terminus/policy-coordinator": ["./packages/policy-coordinator/src/index.ts"],
      "@terminus/artifact-client": ["./packages/artifact-client/src/index.ts"],
      "@terminus/observability": ["./packages/observability/src/index.ts"],
      "@terminus/config": ["./packages/config/src/index.ts"],
      "@terminus/testkit": ["./packages/testkit/src/index.ts"],
      "@terminus/public-api": ["./packages/public-api/src/index.ts"],
      "@terminus/public-client": ["./packages/public-client/src/index.ts"],
      "@terminus/aci": ["./packages/aci/src/index.ts"],
      "@terminus/workflow-compiler": ["./packages/workflow-compiler/src/index.ts"],
      "@terminus/permissions": ["./packages/permissions/src/index.ts"],
      "@terminus/rollout": ["./packages/rollout/src/index.ts"],
      "@terminus/cron": ["./packages/cron/src/index.ts"],
      "@terminus/lsp": ["./packages/lsp/src/index.ts"]
    },
    "types": ["bun-types", "node"]
  },
  "include": [
    "scripts/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
