{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "src",
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@terminus/domain": ["./packages/domain/src/index.ts"],
      "@terminus/runtime-protocol": ["./packages/runtime-protocol/src/index.ts"],
      "@terminus/context-ir": ["./packages/context-ir/src/index.ts"],
      "@terminus/context-compiler": ["./packages/context-compiler/src/index.ts"],
      "@terminus/provider-core": ["./packages/provider-core/src/index.ts"],
      "@terminus/provider-local": ["./packages/provider-local/src/index.ts"],
      "@terminus/model-router": ["./packages/model-router/src/index.ts"],
      "@terminus/task-runtime": ["./packages/task-runtime/src/index.ts"],
      "@terminus/session-runtime": ["./packages/session-runtime/src/index.ts"],
      "@terminus/orchestration": ["./packages/orchestration/src/index.ts"],
      "@terminus/verification": ["./packages/verification/src/index.ts"],
      "@terminus/testkit": ["./packages/testkit/src/index.ts"],
      "@terminus/public-api": ["./packages/public-api/src/index.ts"],
      "@terminus/aci": ["./packages/aci/src/index.ts"]
    }
  }
}

