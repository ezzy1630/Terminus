{
  "name": "@terminus/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "overrides": {
    "defu": "6.1.5",
    "diff": "5.2.2",
    "effect": "3.20.0",
    "js-cookie": "3.0.6",
    "js-yaml": "4.3.1",
    "lodash": "4.18.1",
    "lodash-es": "4.17.23",
    "picomatch": "2.3.2",
    "postcss": "8.5.26",
    "prismjs": "1.30.0",
    "deepmerge-ts": "^8.0.2",
    "nanoid": "3.3.18",
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "mini-services/terminus-control"
  ],
  "scripts": {
    "standalone-check": "bun run tools/standalone-check.ts",
    "control:package": "bun run scripts/package-control-runtime.ts",
    "control:verify-package": "bun run scripts/verify-control-runtime-package.ts",
    "control:test-distribution": "bun test scripts/control-runtime",
    "desktop:inspect-release": "bun run scripts/inspect-desktop-release.ts",
    "desktop:create-runtime-manifest": "bun run scripts/create-desktop-runtime-manifest.ts",
    "desktop:verify-runtime-resources": "bun run scripts/verify-desktop-runtime-resources.ts",
    "desktop:verify-release-evidence": "bun run scripts/verify-desktop-release-evidence.ts",
    "typecheck:packages": "tsc --noEmit -p tsconfig.packages.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "bun run typecheck:packages && bun run typecheck:scripts && bun run typecheck",
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && bun scripts/package-standalone.mjs",
    "build:packages": "bun run typecheck:packages",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test:unit": "bun test packages/*/src",
    "test:integration": "bun test packages/context-compiler/src packages/aci/src packages/model-router/src packages/orchestration/src packages/verification/src",
    "test:security": "cargo test --workspace --test capability_token_e2e --test non_bypassability --test policy_wiring",
    "test:e2e": "bash scripts/e2e/deterministic.sh",
    "test": "bun run test:unit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "dev:stack": "bun run scripts/dev-stack.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@grpc/grpc-js": "^1.14.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^9.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.35.0",
    "next": "^16.2.11",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "prisma": "^7.10.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-syntax-highlighter": "^16.1.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.14",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "minimatch": "^10.2.6",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
