{
  "name": "@terminus/desktop",
  "version": "0.1.0",
  "author": "Terminus",
  "private": true,
  "description": "Terminus desktop application \u2014 a calm, focused Electron UI for the Terminus coding-agent harness.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "bun run build:electron-main && concurrently \"vite\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:electron-main": "tsc -p electron/tsconfig.json",
    "build:electron": "bun run build:electron-main && vite build",
    "preview": "vite preview",
    "lint": "eslint --no-ignore --ext .ts,.tsx src electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "bun run ../../scripts/package-desktop-local.ts --architectures=arm64,x64",
    "package:mac:arm64": "bun run ../../scripts/package-desktop-local.ts --architectures=arm64",
    "package:mac:x64": "bun run ../../scripts/package-desktop-local.ts --architectures=x64",
    "package:dir": "bun run ../../scripts/package-desktop-local.ts --dir",
    "dev:live": "eval \"$(bun run ../../scripts/dev-stack.ts --print-env)\" && vite",
    "dev:electron:live": "eval \"$(bun run ../../scripts/dev-stack.ts --print-env)\" && bun run dev:electron"
  },
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-virtual": "^3.14.5",
    "@terminus/public-api": "workspace:*",
    "@terminus/public-client": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "date-fns": "^4.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.33.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "undici": "^7.29.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "zustand": "^5.0.6"
  },
  "build": {
    "afterPack": "electron/after-pack.cjs",
    "appId": "dev.terminus.desktop",
    "productName": "Terminus",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
