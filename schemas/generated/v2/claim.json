{
  "$id": "https://terminus.dev/schemas/v2/claim.json",
  "title": "Claim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "requiredEvidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "SATISFIED",
        "DISPUTED",
        "WAIVED"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waivedRationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "taskId",
    "statement",
    "requiredEvidenceKind",
    "status",
    "evidenceIds",
    "waivedRationale",
    "createdAt",
    "updatedAt"
  ]
}
