{
  "$id": "https://terminus.dev/schemas/v2/task-attempt.json",
  "title": "TaskAttempt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "attemptNumber": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "fencingToken": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "STARTING",
        "RUNNING",
        "RECOVERING",
        "COMPLETED",
        "FAILED",
        "ABORTED"
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "settledAt": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "taskId",
    "attemptNumber",
    "workerId",
    "fencingToken",
    "status",
    "startedAt"
  ]
}
