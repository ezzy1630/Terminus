{
  "$id": "https://terminus.dev/schemas/v2/counterfactual-experiment.json",
  "title": "CounterfactualExperiment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceTaskId": {
      "type": "string",
      "minLength": 1
    },
    "variationType": {
      "type": "string",
      "enum": [
        "profile",
        "prompt",
        "retrieval",
        "intervention"
      ]
    },
    "variationDetails": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "executionStatus": {
      "type": "string",
      "enum": [
        "planned",
        "completed"
      ]
    },
    "predictedOutcome": {
      "type": "string",
      "minLength": 1
    },
    "actualOutcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "deltaSuccess": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "deltaCostMicros": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "deltaLatencyMs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "sourceTaskId",
    "variationType",
    "variationDetails",
    "executionStatus",
    "predictedOutcome",
    "actualOutcome",
    "deltaSuccess",
    "deltaCostMicros",
    "deltaLatencyMs"
  ]
}
