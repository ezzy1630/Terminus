{
  "$id": "https://terminus.dev/schemas/v2/effect-record.json",
  "title": "EffectRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "connectorOrWorker": {
      "type": "string",
      "minLength": 1
    },
    "intentType": {
      "type": "string",
      "minLength": 1
    },
    "canonicalParameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "resourceHandles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1
          },
          "objectType": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedOperations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "principalBinding": {
            "type": "string",
            "minLength": 1
          },
          "taskBinding": {
            "type": "string",
            "minLength": 1
          },
          "authorityEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "trustLabel": {
            "type": "string",
            "minLength": 1
          },
          "expiry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "integrityHash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "objectId",
          "objectType",
          "version",
          "scope",
          "allowedOperations",
          "principalBinding",
          "taskBinding",
          "authorityEpoch",
          "provenance",
          "trustLabel",
          "expiry",
          "integrityHash"
        ]
      }
    },
    "effectClass": {
      "type": "string",
      "minLength": 1
    },
    "semanticIdempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "authorizationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "policyDecisionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "POLICY_CHECKED",
        "AUTHORIZATION_REQUIRED",
        "AUTHORIZED",
        "PREPARED",
        "DISPATCHED",
        "OBSERVED",
        "VALIDATED",
        "COMMITTED",
        "DENIED",
        "CANCELLED",
        "UNCERTAIN",
        "RECONCILING",
        "COMPENSATING",
        "COMPENSATED",
        "RESIDUE",
        "MANUAL_RECONCILE"
      ]
    },
    "uncertaintyReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "compensationRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string"
    },
    "settledAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "taskId",
    "attemptId",
    "principal",
    "connectorOrWorker",
    "intentType",
    "canonicalParameters",
    "resourceHandles",
    "effectClass",
    "semanticIdempotencyKey",
    "authorizationId",
    "policyDecisionId",
    "state",
    "uncertaintyReason",
    "compensationRef",
    "version",
    "createdAt",
    "settledAt"
  ]
}
