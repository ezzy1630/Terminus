{
  "$id": "https://terminus.dev/schemas/v2/model-profile.json",
  "title": "ModelProfile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "adapterRef": {
      "type": "string",
      "minLength": 1
    },
    "renderingProfileRef": {
      "type": "string",
      "minLength": 1
    },
    "modelKey": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "modelFamilyRef": {
      "type": "string",
      "minLength": 1
    },
    "economics": {
      "type": "object",
      "properties": {
        "inputMicrosPerMillion": {},
        "cachedInputMicrosPerMillion": {},
        "outputMicrosPerMillion": {},
        "reasoningAccounting": {
          "type": "boolean"
        }
      },
      "required": [
        "inputMicrosPerMillion",
        "cachedInputMicrosPerMillion",
        "outputMicrosPerMillion",
        "reasoningAccounting"
      ],
      "additionalProperties": false
    },
    "latencyModel": {
      "type": "object",
      "properties": {
        "p50Ms": {
          "type": "number",
          "minimum": 0
        },
        "p90Ms": {
          "type": "number",
          "minimum": 0
        },
        "p99Ms": {
          "type": "number",
          "minimum": 0
        },
        "ttftMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "p50Ms",
        "p90Ms",
        "p99Ms",
        "ttftMs"
      ],
      "additionalProperties": false
    },
    "allowedConfidentiality": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "workspace",
          "secret_adjacent",
          "secret"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "codingQuality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "toolReliability": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "structuredOutput": {
          "type": "boolean"
        },
        "imageInput": {
          "type": "boolean"
        },
        "advertisedContextTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "testedSafeContextTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "securityReasoning": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasoningStrength": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "offlineExecution": {
          "type": "boolean"
        }
      },
      "required": [
        "codingQuality",
        "toolReliability",
        "structuredOutput",
        "imageInput",
        "advertisedContextTokens",
        "testedSafeContextTokens",
        "securityReasoning",
        "reasoningStrength",
        "offlineExecution"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "adapterRef",
    "renderingProfileRef",
    "modelKey",
    "version",
    "modelFamilyRef",
    "economics",
    "latencyModel",
    "allowedConfidentiality",
    "capabilities"
  ],
  "additionalProperties": false
}
