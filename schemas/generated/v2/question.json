{
  "$id": "https://terminus.dev/schemas/v2/question.json",
  "title": "Question",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selectedOption": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ANSWERED",
        "DISMISSED"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "resolvedAt": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "taskId",
    "prompt",
    "status",
    "createdAt"
  ]
}
