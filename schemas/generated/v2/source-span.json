{
  "$id": "https://terminus.dev/schemas/v2/source-span.json",
  "title": "SourceSpan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "startLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "startColumn": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "endLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "endColumn": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "sourcePath",
    "startLine",
    "startColumn",
    "endLine",
    "endColumn",
    "text"
  ]
}
