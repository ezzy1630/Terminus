{
  "$id": "https://terminus.dev/schemas/v2/operator-agent.json",
  "title": "OperatorAgent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "departmentId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "capabilityScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelProfile": {
      "type": "string",
      "minLength": 1
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "departmentId",
    "displayName",
    "capabilityScope",
    "modelProfile",
    "active"
  ]
}
