{
  "$id": "https://terminus.dev/schemas/v2/workflow-node.json",
  "title": "WorkflowNode",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "deterministic",
        "model_judgment",
        "human",
        "connector",
        "effect",
        "verifier",
        "subworkflow"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "outputs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "requiredCapabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effectClass": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeoutSeconds": {
      "default": 60,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "compensationNodeId": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "owner"
  ]
}
