{
  "$id": "https://terminus.dev/schemas/v2/workflow-node.json",
  "title": "WorkflowNode",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "deterministic",
        "model_judgment",
        "human",
        "connector",
        "effect",
        "verifier",
        "subworkflow"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "outputs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "requiredCapabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trustInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "minTrustLevel": {
            "type": "string",
            "minLength": 1
          },
          "requiredSignatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "minTrustLevel"
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "dialect": {
            "default": "predicate_expr",
            "type": "string",
            "enum": [
              "json_logic",
              "predicate_expr",
              "deterministic"
            ]
          },
          "deterministic": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "dialect": {
            "default": "predicate_expr",
            "type": "string",
            "enum": [
              "json_logic",
              "predicate_expr",
              "deterministic"
            ]
          },
          "deterministic": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    "effectClass": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "verifierKind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claimId",
          "schema",
          "verifierKind"
        ]
      }
    },
    "retryPolicy": {
      "type": "object",
      "properties": {
        "maxRetries": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backoffMs": {
          "default": 1000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nonRetryableErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timeoutSeconds": {
      "default": 60,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxCostMicros": {
          "type": "string"
        },
        "maxTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxWallClockSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "compensationNodeId": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceSpan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sourcePath": {
              "type": "string",
              "minLength": 1
            },
            "startLine": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "startColumn": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "endLine": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "endColumn": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "sourcePath",
            "startLine",
            "startColumn",
            "endLine",
            "endColumn",
            "text"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "ambiguityStatus": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "isAmbiguous": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "requiredJudgment": {
              "type": "string",
              "enum": [
                "model",
                "human"
              ]
            }
          },
          "required": [
            "isAmbiguous",
            "requiredJudgment"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "taintPolicy": {
      "type": "object",
      "properties": {
        "allowTaintedInputs": {
          "default": false,
          "type": "boolean"
        },
        "sanitizeWith": {
          "type": "string"
        },
        "sinkClassification": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "id",
    "kind",
    "owner"
  ]
}
