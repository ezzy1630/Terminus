{
  "$id": "https://terminus.dev/schemas/v2/task-v2.json",
  "title": "TaskV2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "missionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "organizationId": {
      "type": "string",
      "minLength": 1
    },
    "departmentId": {
      "type": "string",
      "minLength": 1
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "objectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "objectType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "scope": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "allowedOperations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "principalBinding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "taskBinding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authorityEpoch": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "provenance": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trustLabel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expiry": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "integrityHash": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "objectId",
                  "objectType",
                  "version",
                  "scope",
                  "allowedOperations",
                  "principalBinding",
                  "taskBinding",
                  "authorityEpoch",
                  "provenance",
                  "trustLabel",
                  "expiry",
                  "integrityHash"
                ]
              }
            },
            "allowedEffectClasses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excludedPathsOrSystems": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "resources",
            "allowedEffectClasses",
            "excludedPathsOrSystems"
          ]
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claimId": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRequirement": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "claimId",
              "statement",
              "evidenceRequirement"
            ]
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "security": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "costMicros": {},
            "timeoutSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "security",
            "costMicros",
            "timeoutSeconds"
          ]
        },
        "authorityCeiling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "mission",
        "scope",
        "acceptance",
        "constraints",
        "authorityCeiling",
        "mode"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "RUNNING",
        "WAITING_USER",
        "WAITING_AUTH",
        "WAITING_RESOURCE",
        "PAUSED",
        "VERIFYING",
        "COMPLETED",
        "PARTIAL",
        "BLOCKED",
        "CANCELLED",
        "FAILED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "completedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "missionId",
    "organizationId",
    "departmentId",
    "createdBy",
    "contract",
    "status",
    "version",
    "createdAt",
    "updatedAt",
    "completedAt"
  ]
}
