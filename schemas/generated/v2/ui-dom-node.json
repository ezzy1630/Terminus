{
  "$id": "https://terminus.dev/schemas/v2/ui-dom-node.json",
  "title": "UiDomNode",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "boundingBox": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "isInteractive": {
      "type": "boolean"
    },
    "childrenNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "nodeId",
    "tag",
    "attributes",
    "text",
    "boundingBox",
    "isInteractive",
    "childrenNodeIds"
  ]
}
