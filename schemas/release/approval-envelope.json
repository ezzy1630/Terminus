{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.dev/schemas/release/approval-envelope.json",
  "title": "ReleaseApprovalEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "key_id",
    "signed_payload",
    "signature_base64"
  ],
  "properties": {
    "schema": { "const": "terminus.release-approval-envelope.v1" },
    "algorithm": { "const": "ed25519" },
    "key_id": { "type": "string", "minLength": 1 },
    "signed_payload": { "type": "string", "minLength": 1 },
    "signature_base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
