# Forge environment variables.
# Copy this file to .env and adjust as needed.

# SQLite database location (Prisma).
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Rust kernel mini-service auth token.
FORGE_KERNEL_TOKEN=forge-kernel-dev-token

# Kernel-side capability token (minted at kernel startup; logged to kernel.log).
FORGE_KERNEL_CAP_TOKEN=
