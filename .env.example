# Terminus environment variables.
# Copy this file to .env and adjust as needed.

# Set TERMINUS_DEV=1 to permit the well-known dev tokens below for local
# development. WITHOUT this, the control plane and kernel fail closed if no
# real token is configured (SPEC §13.6 / §31.6). NEVER set TERMINUS_DEV=1 in
# production.
TERMINUS_DEV=1

# SQLite database location (Prisma / bun:sqlite).
DATABASE_URL=file:~/.local/share/terminus/terminus.db

# Rust kernel mini-service auth token (required unless TERMINUS_DEV=1).
TERMINUS_KERNEL_TOKEN=terminus-kernel-dev-token

# Control plane auth token (required unless TERMINUS_DEV=1).
TERMINUS_CONTROL_TOKEN=terminus-control-dev-token

# Kernel-side capability token (minted at kernel startup; published to
# TERMINUS_KERNEL_CAP_TOKEN_FILE when set, never logged).
TERMINUS_KERNEL_CAP_TOKEN=

# Browser origins allowed to call the kernel HTTP API directly (comma-
# separated). Leave unset for loopback/UDS clients and the Caddy gateway;
# the kernel never sends wildcard CORS headers.
# TERMINUS_KERNEL_CORS_ORIGIN=http://127.0.0.1:81

# gRPC-over-UDS socket the control plane uses for privileged kernel effects.
# Required by mini-services/terminus-control; without it the control plane
# refuses privileged operations at request time.
# TERMINUS_KERNEL_GRPC_SOCKET=unix:/run/terminus/kernel.sock

# Control plane HTTP port (default 3050).
# TERMINUS_CONTROL_PORT=3050

# CORS origin allowed to call the control plane (default http://127.0.0.1:81).
# TERMINUS_CONTROL_CORS_ORIGIN=http://127.0.0.1:81

# Gateway/API base used by CLI, TUI, IDE-ACP adapter, and desktop app.
# TERMINUS_GATEWAY=http://127.0.0.1:81
# VITE_TERMINUS_API_BASE=http://127.0.0.1:3050
# VITE_TERMINUS_TOKEN=

# Desktop Electron: enable devtools in packaged builds (never enable in prod).
# TERMINUS_DESKTOP_DEVTOOLS=

# Set TERMINUS_STRICT_SANDBOX=1 to fail closed when the sandbox backend reports
# Degraded enforcement (SPEC §13.4). Leave unset on platforms without a real
# OS sandbox backend (e.g. macOS) so degraded enforcement is audited but
# allowed; set it on Linux once a Bubblewrap backend is wired.
# TERMINUS_STRICT_SANDBOX=1
